# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python environments
.venv/
venv/
ENV/
env/

# ML Model weights, checkpoints, and artifacts
checkpoints/*
!checkpoints/.gitkeep
artifacts/*
!artifacts/.gitkeep
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.ckpt
*.pkl
*.joblib
*.h5

# Datasets and large data stores
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.json
data/processed/*
!data/processed/.gitkeep
!data/processed/split_manifest.json
data/validation/*
!data/validation/.gitkeep
!data/validation/corpus_validation_report.json
!data/validation/stage_b_validation_report.json
data/tokenized/*
!data/tokenized/.gitkeep
!data/manifests/
!data/manifests/*
!data/statistics/
!data/statistics/*
*.arrow
*.parquet
*.tar
*.tar.gz
*.zip

# Logs, monitoring, and profiling
*.log
logs/
runs/
wandb/
.tensorboard/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
scratch/
data/sources/

# Build and distribution
build/
dist/
*.egg-info/
*.whl

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
